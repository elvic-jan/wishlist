<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wishlist.Domain\Wishlist.Domain.csproj" />
    <ProjectReference Include="..\Wishlist.Application\Wishlist.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      MailKit 4.16.0 patches GHSA-9j88-vvj5-vhgr (STARTTLS Response Injection)
      and transitively pulls in MimeKit >= 4.15.1, which patches
      GHSA-g7hc-96xr-gvvx (CRLF injection in quoted local-part → SMTP command
      injection). Both vulnerabilities are reachable from our SmtpEmailSender
      (we use SecureSocketOptions.StartTls and feed user-supplied addresses
      through MailboxAddress.Parse), so we MUST stay on a patched line.
      4.18.2 also brings System.Security.Cryptography.Pkcs 10.0.13; 4.17.0
      pulled in 10.0.0, which has GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx.
    -->
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
